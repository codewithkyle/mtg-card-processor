{
  "name": "divinedrop-card-processor",
  "private": true,
  "description": "Turns the Scryfall bulk export into card images in R2 and rows in the divinedrop database.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "phase0": "node index.js --phase 0",
    "phase1": "node index.js --phase 1",
    "phase2": "node index.js --phase 2",
    "phase3": "node index.js --phase 3",
    "phase4": "node index.js --phase 4",
    "phase5": "node index.js --phase 5",
    "fetch": "node index.js --phase 0",
    "process": "node index.js --phase 1",
    "download": "node index.js --phase 2",
    "validate": "node index.js --phase 3",
    "convert": "node index.js --phase 4",
    "upload": "node index.js --phase 5",
    "import": "node import.js --file import.jsonl",
    "import:dry": "node import.js --file import.jsonl --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.186.0",
    "clear": "^0.1.0",
    "cli-progress": "^3.9.1",
    "dotenv": "^8.6.0",
    "glob": "^11.0.0",
    "mysql2": "^3.6.0",
    "node-fetch": "^2.6.5",
    "stream-chain": "^2.2.4",
    "stream-json": "^1.7.3",
    "uuid": "^9.0.0",
    "webcpu": "^0.4.8",
    "yargs": "^16.2.0"
  }
}
