# The database import.js writes to. The application's own DSN is also honoured
# if it is set, in either the Go driver's format or as a mysql:// uri - see the
# note at the top of import.js.
DB_HOST=localhost
DB_PORT=3306
DB_USER=ddadmin
DB_PASSWORD=password
DB_NAME=divinedrop

# Object store the card images are written to. These are the same names the
# application reads in helpers/s3.go, so one file can serve both repos.
#
# There are no defaults for the endpoint or the credentials on purpose: an
# incomplete file should stop phase 5, not send 16GB somewhere plausible.
#
# For Cloudflare R2, which is what this serves from:
#   S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=true
#   S3_ACL unset - R2 has no per object ACLs and rejects the header
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=divinedrop
S3_FORCE_PATH_STYLE=true
S3_ACL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
