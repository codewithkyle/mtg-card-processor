DB_HOST=localhost
DB_PORT=3306
DB_USER=ddadmin
DB_PASSWORD=password
DB_NAME=divinedrop

# Object store the card images are written to. These are the same names the
# application reads in helpers/s3.go, so one file can serve both repos.
# For Cloudflare R2:
#   S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=true
#   leave S3_ACL unset - R2 has no per object ACLs and rejects the header
# For the DigitalOcean Space this is migrating away from:
#   S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
#   S3_REGION=us-east-1
#   S3_FORCE_PATH_STYLE=false
#   S3_ACL=public-read
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=divinedrop
S3_FORCE_PATH_STYLE=true
S3_ACL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
